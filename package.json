{
	"name": "svobodaiznutri",
	"version": "2.0.0",
	"description": "Archived blog about eco-building, powered by 11ty",
	"scripts": {
		"build": "npx @11ty/eleventy",
		"build-ghpages": "npx @11ty/eleventy --pathprefix=/",
		"start": "npx @11ty/eleventy --serve --quiet",
		"start:clean": "rm -Rf _site && npx @11ty/eleventy --serve --quiet",
		"debug": "DEBUG=Eleventy* npx @11ty/eleventy"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Gotterbild/svobodaiznutri.git"
	},
	"author": {
		"name": "Pavel Dolgov"
	},
	"license": "Content and source code are separately licensed. The content is licensed under the CC BY 4.0 license. The source code for page structure, CSS and JS code are licensed under the MIT.",
	"engines": {
		"node": ">=18"
	},
	"homepage": "https://svobodaiznutri.com",
	"bugs": {
		"url": "https://github.com/Gotterbild/svobodaiznutri/issues"
	},
	"devDependencies": {
		"@11ty/eleventy": "^2.0.1",
		"@11ty/eleventy-plugin-rss": "^1.2.0",
		"luxon": "^3.3.0"
	}
}
