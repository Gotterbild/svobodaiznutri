{#- WordPress-like page numbers: < 1 … 4 5 [6] 7 8 … 11 > -#}
{%- if pagination.pages.length > 1 %}
	<div id="nav-below">
		<nav id="post_nav" aria-label="Страницы">
			{%- if pagination.href.previous %}
				<a class="prev page-numbers" href="{{ pagination.href.previous }}" aria-label="Предыдущая страница">&lt;</a>
			{%- endif %}
			{%- for n in pagination.pageNumber | paginationItems(pagination.pages.length) %}
				{%- if n == "…" %}
					<span class="page-numbers dots">&hellip;</span>
				{%- elif n == pagination.pageNumber + 1 %}
					<span class="page-numbers current" aria-current="page">{{ n }}</span>
				{%- else %}
					<a class="page-numbers" href="{{ pagination.hrefs[n - 1] }}">{{ n }}</a>
				{%- endif %}
			{%- endfor %}
			{%- if pagination.href.next %}
				<a class="next page-numbers" href="{{ pagination.href.next }}" aria-label="Следующая страница">&gt;</a>
			{%- endif %}
		</nav>
	</div>
{%- endif %}
