{#- WordPress-like page numbers: < 1 … 4 5 [6] 7 8 … 11 >
    Expects `pager`: { pageNumber (0-based), hrefs, previous, next } -#}
{%- if pager.hrefs.length > 1 %}
	<div id="nav-below">
		<nav id="post_nav" aria-label="Страницы">
			{%- if pager.previous %}
				<a class="prev page-numbers" href="{{ pager.previous }}" aria-label="Предыдущая страница">&lt;</a>
			{%- endif %}
			{%- for n in pager.pageNumber | paginationItems(pager.hrefs.length) %}
				{%- if n == "…" %}
					<span class="page-numbers dots">&hellip;</span>
				{%- elif n == pager.pageNumber + 1 %}
					<span class="page-numbers current" aria-current="page">{{ n }}</span>
				{%- else %}
					<a class="page-numbers" href="{{ pager.hrefs[n - 1] }}">{{ n }}</a>
				{%- endif %}
			{%- endfor %}
			{%- if pager.next %}
				<a class="next page-numbers" href="{{ pager.next }}" aria-label="Следующая страница">&gt;</a>
			{%- endif %}
		</nav>
	</div>
{%- endif %}
